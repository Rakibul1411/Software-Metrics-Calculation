# Copy to .env only if you use Docker Compose.
POSTGRES_DB=defectlab
POSTGRES_USER=defectlab
POSTGRES_PASSWORD=defectlab

# For Neon, replace the three backend variables in docker-compose.yml or export
# them before `docker compose up --build`.
DEFECTLAB_DB_URL=jdbc:postgresql://postgres:5432/defectlab
DEFECTLAB_DB_USER=defectlab
DEFECTLAB_DB_PASSWORD=defectlab

ML_SERVICE_TOKEN=replace-with-a-long-random-value
DEFECTLAB_SESSION_SECURE=false
